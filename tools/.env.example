# Bearer token shared by the tool registry in Optimizely AI and this service. Both tools reject calls without it.
OPTITHERA_REGULATED_REGISTRY_TOKEN=replace_me

# Optional. When set, submit_readiness_result stores results in a private Vercel Blob store.
# When unset, results go to a local file store (READINESS_STORE_DIR, default: the OS temp directory).
BLOB_READ_WRITE_TOKEN=
READINESS_STORE_DIR=
